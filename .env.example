# Configuration locale : ne jamais copier de véritables secrets dans Git.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Stripe : laisser vides jusqu'à la création des clés dans le Dashboard Stripe.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_LIVE_MODE=False

# Domaine canonique utilisé pour construire les URL de retour, jamais fourni par le navigateur.
SITE_BASE_URL=http://127.0.0.1:8000

# Tarifs actuels de la maquette, à confirmer avant ouverture commerciale.
CHECKOUT_STANDARD_SHIPPING=4.90
CHECKOUT_EXPRESS_SHIPPING=9.90
CHECKOUT_FREE_SHIPPING_THRESHOLD=80.00
# Délais à renseigner seulement après validation logistique ; laisser vides sinon.
CHECKOUT_STANDARD_DELIVERY_DAYS=
CHECKOUT_EXPRESS_DELIVERY_DAYS=

# Production uniquement : backend partagé et driver à installer selon l'hébergement validé.
# DJANGO_SHARED_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_SHARED_CACHE_LOCATION=redis://cache-host:6379/1
# Alternative : django.core.cache.backends.memcached.PyMemcacheCache (driver pymemcache).
# Ne pas commiter d'URL contenant des identifiants.

# Développement uniquement : autorise le tunnel test sans valider les textes commerciaux.
# Nécessite DEBUG=True, clé sk_test_, STRIPE_LIVE_MODE=False et SITE_BASE_URL local.
LOCAL_TEST_CHECKOUT=true
